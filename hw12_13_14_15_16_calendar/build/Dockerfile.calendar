# Build stage
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the calendar binary
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o calendar ./cmd/calendar

# Runtime stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates gettext wget

WORKDIR /root/

# Copy binary from builder
COPY --from=builder /app/calendar .

# Copy config templates
COPY --from=builder /app/configs ./configs

# Expose port
EXPOSE 8888

# Generate config from template and run
CMD sh -c "envsubst < ./configs/config.toml.template > ./configs/config.toml && ./calendar -config ./configs/config.toml"
