# Build stage
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the storer binary
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o calendar_storer ./cmd/calendar_storer

# Runtime stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates gettext

WORKDIR /root/

# Copy binary from builder
COPY --from=builder /app/calendar_storer .

# Copy config templates
COPY --from=builder /app/configs ./configs

# Generate config from template and run
CMD sh -c "envsubst < ./configs/storer_config.toml.template > ./configs/storer_config.toml && ./calendar_storer -config ./configs/storer_config.toml"
