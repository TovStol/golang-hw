# Build stage for integration tests
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the integration test binary (or just run tests directly)
# We'll run tests directly in the runtime stage

# Runtime stage
FROM golang:1.22-alpine

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download && go get github.com/lib/pq

# Copy source code
COPY . .

# Install dependencies for running tests
RUN apk --no-cache add ca-certificates

# Run integration tests
CMD ["go", "test", "-tags", "integration", "-v", "-timeout", "120s", "./integration/..."]
